{
  "name": "llm-d-simul",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "python3 scripts/setup.py && npm run setup:build",
    "setup:build": "python3 scripts/build-blis.py",
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "sh scripts/go.sh run ./cmd/server",
    "build": "tsc -b && vite build",
    "start": "sh scripts/go.sh run ./cmd/server",
    "test": "sh scripts/go.sh test ./cmd/server",
    "test:integration": "node scripts/verify-integration.mjs",
    "catalog:sync": "python3 scripts/sync-deployments.py",
    "test:deployments": "node scripts/verify-deployments.mjs",
    "test:workloads": "node scripts/verify-workloads.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "~5.9.3",
    "vite": "^7.1.7"
  }
}
